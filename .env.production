# ADT InnoFest 2026 web app config (Firebase console -> Project settings -> Your apps -> Web).
# Not secret: every value here ships inside the public JavaScript bundle anyway. Committed so a
# build from GitHub Actions or any laptop targets the right project without extra setup.
VITE_FIREBASE_API_KEY=AIzaSyAwsdn1OCYTMnyzyWC-w703JsewATMwlPE
# The Hosting domain, not firebaseapp.com: Google sign-in redirects inside LINE/Facebook webviews
# must come back to the app's own origin (see .env.local.example).
VITE_FIREBASE_AUTH_DOMAIN=adt-innofest.web.app
VITE_FIREBASE_PROJECT_ID=adt-innofest
VITE_FIREBASE_STORAGE_BUCKET=adt-innofest.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=501220216394
VITE_FIREBASE_APP_ID=1:501220216394:web:54836f282a45233c7ba0b3
# Booth QR payloads embed this, so it must match Hosting exactly.
VITE_APP_ORIGIN=https://adt-innofest.web.app
